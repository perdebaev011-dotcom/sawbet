.cf button,.btn{background:var(--acc2);color:#fff;border-radius:10px;padding:9px 16px;font-weight:600}
.btn{width:100%;padding:13px;margin-top:12px}
.pad{padding:16px}
.drop{aspect-ratio:1/1;border:2px dashed var(--line);border-radius:14px;display:grid;place-items:center;text-align:center;color:var(--mute);cursor:pointer;overflow:hidden;background:var(--card)}
.drop img{width:100%;height:100%;object-fit:cover}
.prof{display:flex;align-items:center;gap:18px;padding:20px 16px}
.prof .av{width:80px;height:80px;font-size:30px;flex:none}
.nums{display:flex;gap:22px;margin-top:6px}.nums div{text-align:center}.nums b{display:block;font-size:18px}.nums span{font-size:13px;color:var(--mute)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.grid .img{aspect-ratio:1/1;font-size:11px;padding:6px;cursor:pointer}
.empty{text-align:center;color:var(--mute);padding:40px 20px}
.add h2,.pbody h2{margin:0;font:600 20px Unbounded,sans-serif}
.pick{display:grid;place-items:center;aspect-ratio:4/5;border-radius:20px;overflow:hidden;cursor:pointer;color:#fff;text-align:center;margin-top:12px}
.pick img{width:100%;height:100%;object-fit:cover}
.pl{display:grid;gap:6px;justify-items:center}.pl svg{width:44px;height:44px;stroke-width:1.5}.pl small{opacity:.85}
.sws{display:flex;gap:10px;margin:14px 0}
.sw{width:34px;height:34px;border-radius:50%;border:3px solid var(--bg)}
.sw.on{box-shadow:0 0 0 2px var(--ink)}
.lnk{color:var(--acc);font-weight:600;margin:12px 0;display:block}
.field{position:relative}.field textarea{resize:none;padding-bottom:26px}.field small{position:absolute;right:12px;bottom:8px;color:var(--mute)}
.cover{height:120px}
.pbody{padding:16px 16px 0}
.img video,.pick video{width:100%;height:100%;object-fit:cover;background:#000;display:block}
.grid video{pointer-events:none}
.chip{border:1px solid var(--line);border-radius:20px;padding:6px 14px;background:var(--card)}
.hint{display:block;color:var(--mute);margin-top:8px}
.err{color:var(--acc);min-height:20px;margin-top:10px;font-weight:600}
.eb .ghost{font-size:13px}
.pr{display:flex;gap:16px;align-items:center}.pr .av{flex:none}.pi{flex:1;min-width:0}.pi h2{overflow-wrap:anywhere}.pi .bio{margin:4px 0 0;color:var(--mute)}
.eb{display:flex;gap:10px;margin:14px 0}.eb .ghost{flex:1;padding:10px}.eb .sv{width:auto;margin:0;flex:1;padding:10px}
.av.big{width:88px;height:88px;font-size:34px;border:4px solid var(--bg)}
.nm{display:flex;justify-content:space-between;align-items:flex-end;margin-top:10px}
.nm small{color:var(--mute)}
.ghost{border:1px solid var(--line);border-radius:10px;padding:8px 14px;font-weight:600}
.bio{margin:10px 0 14px}
.stats{display:flex;background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:16px}
.stats div{flex:1;text-align:center;padding:12px 0}.stats div+div{border-left:1px solid var(--line)}
.stats b{display:block;font-size:18px}.stats span{font-size:13px;color:var(--mute)}
.plus{flex:none;width:54px;height:40px;margin:5px 8px;padding:0;color:#fff;background:linear-gradient(135deg,var(--acc2),var(--acc));border-radius:14px}
.plus.on{color:#fff}
.fw{margin-left:auto;background:var(--acc2);color:#fff;border-radius:10px;padding:6px 14px;font-weight:600;font-size:13px}
.fw.on{background:var(--bg);color:var(--ink);border:1px solid var(--line)}
.row{display:flex;align-items:center;gap:12px;padding:10px 16px;cursor:pointer}
.row .av{width:44px;height:44px;flex:none;border:0}.row div{flex:1;min-width:0}
.row small{display:block;color:var(--mute);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .fw{flex:none}.ico{flex:none;color:var(--mute)}
.chh{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line)}
.chh .av{width:34px;height:34px;border:0;flex:none}.chh #bk{font-size:28px;line-height:1;padding:0 6px}
.msgs{display:flex;flex-direction:column;gap:6px;padding:14px 14px 130px}
.b{max-width:78%;padding:9px 13px;border-radius:18px;background:var(--card);border:1px solid var(--line);align-self:flex-start;overflow-wrap:anywhere}
.b.me{align-self:flex-end;background:var(--acc2);color:#fff;border-color:transparent}
.chf{position:fixed;left:0;right:0;bottom:calc(52px + env(safe-area-inset-bottom,0px));max-width:520px;margin:0 auto;background:var(--bar);border-top:1px solid var(--line);z-index:8}
nav{position:fixed;bottom:0;left:0;right:0;z-index:9;background:var(--bar);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
nav div{max-width:520px;margin:0 auto;display:flex;justify-content:space-around}
nav button{flex:1;padding:12px 0;color:var(--mute);display:grid;place-items:center}nav button.on{color:var(--acc2)}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:20px;z-index:20}
@media (prefers-reduced-motion:no-preference){.liked svg{animation:pop .25s}@keyframes pop{50%{transform:scale(1.3)}}}
</style>
</head>
