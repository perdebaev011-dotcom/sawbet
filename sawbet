var CHAT='<svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-5.4A8 8 0 1 1 21 12z"/></svg>';
function postHTML(p){var L=S.liked[p.id];
return'<article class="post" data-id="'+p.id+'"><div class="ph">'+av(dn(p.u))+"<div><b>"+esc(dn(p.u))+"</b><small>"+esc(p.ts)+"</small></div>"+(p.u===ME?"":fb(p.u))+"</div>"+pic(p)+
'<div class="acts"><button class="like '+(L?"liked":"")+'" aria-label="Yoqdi">'+HEART+"<span>"+(p.l+(L?1:0))+'</span></button><button class="foc" aria-label="Izoh">'+CHAT+"<span>"+p.m.length+"</span></button></div>"+
'<div class="cap"><b>'+esc(dn(p.u))+"</b>"+esc(p.c)+"</div>"+
p.m.map(function(c){return'<div class="cm"><b>'+esc(dn(c.u))+"</b> "+esc(c.t)+"</div>"}).join("")+
'<div class="cf"><input placeholder="Izoh yozing" maxlength="200" aria-label="Izoh"><button class="send">Yuborish</button></div></article>'}
function stories(){var us=[ME,"aziza","jasur","madina","sardor","dilnoza"];
return'<div class="stories">'+us.map(function(u){return'<div class="st"><div class="ring">'+av(u)+"</div>"+esc(u)+"</div>"}).join("")+"</div>"}
var CAM='<svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>';
function keepAdd(){var el=document.getElementById("cap"),t=el?el.value:"";render();var n=document.getElementById("cap");if(n){n.value=t;document.getElementById("cnt").textContent=t.length+"/300"}}
function addHTML(){var sw=G.map(function(_,i){return'<button class="sw'+(i===bgi?' on':'')+'" data-bg="'+i+'" style="background:'+grad(i)+'" aria-label="Fon '+(i+1)+'"></button>'}).join('');return'<div class="pad add"><h2>Yangi post</h2><label class="pick" style="background:'+(draft||dv?'none':grad(bgi))+'">'+(dv?'<video src="'+dvu+'#t=0.1" muted playsinline preload="metadata"></video>':draft?'<img src="'+draft+'" alt="">':'<span class="pl">'+CAM+'<b>Rasm yoki video tanlang</b><small>yoki pastdan fon tanlang</small></span>')+'<input type="file" accept="image/*,video/*" id="file" hidden></label><label class="lnk" style="cursor:pointer">Faqat video tanlash<input type="file" accept="video/*" id="file3" hidden></label><label class="lnk" style="cursor:pointer">Fayllar ichidan tanlash<input type="file" accept="*/*" id="file2" hidden></label>'+(draft||dv?'<button class="lnk" id="rm">Faylni olib tashlash</button>':'<div class="sws">'+sw+'</div>')+'<div class="field"><textarea id="cap" rows="3" maxlength="300" placeholder="Nima haqida yozmoqchisiz?"></textarea><small id="cnt">0/300</small></div><button class="btn" id="pub">Nashr qilish</button></div>'}
function meHTML(){var mine=S.posts.filter(function(p){return p.u===ME}),lk=0,cm=0;mine.forEach(function(p){lk+=p.l;cm+=p.m.length});return'<div class="pbody"><div class="pr">'+av(S.name).replace('class="av"','class="av big"')+'<div class="pi">'+(editing?'<input id="namef" maxlength="24" value="'+esc(S.name)+'" aria-label="Ism" placeholder="Ismingiz"><input id="biof" maxlength="80" value="'+esc(S.bio)+'" aria-label="Bio" placeholder="Bio yozing" style="margin-top:8px">':'<h2>'+esc(S.name)+'</h2><p class="bio">'+esc(S.bio)+'</p>')+'</div></div><div class="eb"><button class="ghost" id="editbio">'+(editing?'Bekor qilish':'Tahrirlash')+'</button>'+(editing?'<button class="btn sv" id="savebio">Saqlash</button>':'')+'</div><div class="eb"><button class="ghost" id="swacc">Almashtirish</button><button class="ghost" id="addacc">Qo‘shish</button><button class="ghost" id="out">Chiqish</button></div><div class="stats"><div><b>'+mine.length+'</b><span>post</span></div><div><b>'+lk+'</b><span>yoqdi</span></div><div><b>'+Object.keys(S.follow).length+'</b><span>obuna</span></div></div></div>'+(mine.length?'<div class="grid">'+mine.map(function(p){return'<div data-open="'+p.id+'">'+pic(p)+'</div>'}).join('')+'</div>':'<div class="empty">Siz hali post qo‘shmagansiz.<button class="btn" data-go="add">Birinchi postni qo‘shing</button></div>')}
function dn(u){return u===ME?S.name:u}
