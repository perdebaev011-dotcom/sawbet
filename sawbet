svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.liked svg{fill:var(--acc);stroke:var(--acc)}
.cap{padding:2px 14px 6px}.cap b{margin-right:6px}
.cm{padding:0 14px;color:var(--mute);font-size:14px}.cm b{color:var(--ink)}
.cf{display:flex;gap:8px;padding:8px 14px 12px}
