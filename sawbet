function rows(q){var r=allU().filter(function(x){return x[0].indexOf(q.trim().toLowerCase())>-1});return r.length?r.map(function(x){return'<div class="row">'+av(x[0])+'<div><b>'+x[0]+'</b><small>'+esc(x[1])+'</small></div>'+fb(x[0])+'<button class="ico" data-chat="'+x[0]+'" aria-label="Xabar yozish">'+CHAT+'</button></div>'}).join(''):'<div class="empty">Akkaunt topilmadi. Boshqa nom yozib ko‘ring.</div>'}
function searchHTML(){return'<div class="pad"><input id="q" placeholder="Akkaunt izlash" aria-label="Izlash" autocomplete="off"></div><div id="res">'+rows('')+'</div>'}
function chatsHTML(){return'<div class="pad add"><h2>Xabarlar</h2></div>'+allU().map(function(x){var m=S.chats[x[0]]||[],l=m[m.length-1];return'<div class="row" data-chat="'+x[0]+'">'+av(x[0])+'<div><b>'+x[0]+'</b><small>'+(l?esc(l.t):'Xabar yozing')+'</small></div></div>'}).join('')}
function convHTML(){var m=S.chats[cur]||[];return'<div class="chh"><button id="bk" aria-label="Orqaga">‹</button>'+av(cur)+'<b>'+cur+'</b></div><div class="msgs">'+(m.length?m.map(function(x){return'<div class="b'+(x.m?' me':'')+'">'+esc(x.t)+'</div>'}).join(''):'<div class="empty">Birinchi xabarni yozing.</div>')+'</div><div class="cf chf"><input id="mi" maxlength="500" placeholder="Xabar yozing" aria-label="Xabar" autocomplete="off"><button id="ms">Yuborish</button></div>'}
function refresh(){var q=document.getElementById("q"),v=q?q.value:"";render();if(q){document.getElementById("q").value=v;document.getElementById("res").innerHTML=rows(v)}}
var idle;function bump(){clearTimeout(idle);if(ME)idle=setTimeout(function(){logout("in");toast("Xavfsizlik uchun chiqdingiz (15 daqiqa harakatsiz)")},900000)}
["click","keydown","touchstart"].forEach(function(t){document.addEventListener(t,bump,{passive:true})});
var authMode="in",authMsg="";
function allU(){var r=US.slice();Object.keys(S.accounts).forEach(function(u){if(u!==ME)r.push([u,S.accounts[u].bio])});return r}
function taken(u){return !!S.accounts[u]||u==="siz"||US.some(function(x){return x[0]===u})}
function load(u){var a=S.accounts[u];ME=u;S.cur=u;S.name=a.name;S.bio=a.bio;S.follow=a.follow;S.chats=a.chats;S.liked=a.liked;cur=null;editing=false;bump();save()}
function logout(m){save();ME=null;S.cur=null;cur=null;editing=false;authMode=m||"in";authMsg="";save();render()}
function cyrb(s){var h1=0xdeadbeef,h2=0x41c6ce57;for(var i=0;i<s.length;i++){var c=s.charCodeAt(i);h1=Math.imul(h1^c,2654435761);h2=Math.imul(h2^c,1597334677)}h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);return(4294967296*(2097151&h2)+(h1>>>0)).toString(16)}
