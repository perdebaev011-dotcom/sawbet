{id:1,u:"aziza",g:0,t:"Tong, shahar, choy",c:"Bugun erta turdim. Hammaga xayrli kun!",l:24,m:[{u:"jasur",t:"Zo‘r chiqibdi!"}],ts:"2 soat"},
{id:2,u:"jasur",g:1,t:"Yangi loyiha",c:"Bir oylik mehnat natijasi. Fikringizni yozing.",l:61,m:[],ts:"5 soat"},
{id:3,u:"madina",g:2,t:"Sayohat",c:"Dengiz bo‘yida dam olish.",l:112,m:[{u:"aziza",t:"Qaysi joy bu?"}],ts:"1 kun"}];
var S;try{S=JSON.parse(localStorage.getItem(KEY))}catch(e){S=null}
if(!S||!S.posts)S={posts:SEED,liked:{},bio:"Sáwbetke xush kelibsiz"};
if(!S.accounts)S.accounts={};if(S.cur&&S.accounts[S.cur])load(S.cur);else S.cur=null;if(!S.name)S.name="siz";if(!S.follow)S.follow={};if(!S.chats)S.chats={};if(S.bio&&S.bio.indexOf("Lahza")===0)S.bio="Sáwbetke xush kelibsiz";var tab="feed",draft=null,bgi=0,dv=null,dvu="",editing=false,cur=null,US=[["aziza","Tong va choy"],["jasur","Dasturchi"],["madina","Sayohat"],["sardor","Fotograf"],["dilnoza","Oshpaz"]],view=document.getElementById("view");
