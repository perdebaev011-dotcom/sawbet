<style>
:root{--bg:#f2f3fa;--card:#fff;--ink:#1c1b3a;--mute:#6b6a8a;--line:#e1e2f0;--acc:#e8365d;--acc2:#5b4bdb;--bar:rgba(255,255,255,.92);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14132a;--card:#1e1d3a;--ink:#f0f0fb;--mute:#9a99bd;--line:#2e2d52;--bar:rgba(30,29,58,.92);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#14132a;--card:#1e1d3a;--ink:#f0f0fb;--mute:#9a99bd;--line:#2e2d52;--bar:rgba(30,29,58,.92);color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.45 Onest,system-ui,sans-serif;background-color:var(--bg)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bar);z-index:10}
#app{max-width:520px;margin:0 auto;padding:0 0 84px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bar);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.logo{font:600 22px Unbounded,sans-serif;background:linear-gradient(90deg,var(--acc2),var(--acc));-webkit-background-clip:text;background-clip:text;color:transparent}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--acc2);outline-offset:2px}
.stories{display:flex;gap:14px;overflow-x:auto;padding:14px 16px}
.st{flex:none;text-align:center;width:64px;font-size:12px}
.ring{width:62px;height:62px;border-radius:50%;padding:3px;background:conic-gradient(var(--acc),var(--acc2),var(--acc));margin-bottom:4px}
.av{width:100%;height:100%;border-radius:50%;border:2px solid var(--bg);display:grid;place-items:center;font-weight:600;color:#fff}
.post{background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:10px}
.ph{display:flex;align-items:center;gap:10px;padding:10px 14px}
.ph .av{width:34px;height:34px;border:0;font-size:14px;flex:none}
.ph b{display:block;line-height:1.2}.ph small{color:var(--mute)}
.img{aspect-ratio:1/1;width:100%;display:grid;place-items:center;color:rgba(255,255,255,.9);font:600 26px Unbounded,sans-serif;text-align:center;padding:24px;overflow:hidden;user-select:none}
.img img{width:100%;height:100%;object-fit:cover;display:block}
.acts{display:flex;gap:16px;padding:10px 14px 2px}
